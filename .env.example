# Copie para .env e preencha. O schema em src/shared/config/env.ts é a fonte de verdade:
# variável inválida ou obrigatória ausente derruba o boot listando os problemas.

# Aplicação
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# CSV de origens permitidas no CORS. Vazio = reflete qualquer origem. "*" é rejeitado.
# localhost:3000 = maia-client (Next), localhost:4200 = maia-frontend (Angular). Em produção, defina no Railway.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
LOG_LEVEL=info
# Swagger em /docs, só fora de produção
SWAGGER_ENABLED=true
# Integrações externas: mock (fakes em memória, default em NODE_ENV=test) | live (default fora de test)
INTEGRATION_MODE=live

# Cliente HTTP resiliente (src/infrastructure/integration/http-client)
HTTP_TIMEOUT_MS=10000
HTTP_RETRIES=2
HTTP_BACKOFF_BASE_MS=200
HTTP_CIRCUIT_FAILURE_THRESHOLD=5
HTTP_CIRCUIT_OPEN_MS=30000
# CSV de hosts permitidos para chamadas HTTP manuais (SSRF guard). Host novo entra aqui.
HTTP_ALLOWED_HOSTS=api.voyageai.com

# Banco de dados (obrigatória)
DATABASE_URL=postgres://user:password@localhost:5432/split_ai
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Autenticação (JWT_SECRET obrigatória)
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRATION_HOURS=24

# IA
ANTHROPIC_API_KEY=
# Endpoint compatível com a API Anthropic. Default preserva o endpoint DeepSeek que o código usava antes.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
AI_MODEL=
ORCHESTRATOR_MODEL=claude-sonnet-4-6
LANGCHAIN_PROJECT=

# Retrieval (Voyage + pgvector)
VOYAGEAI_API_KEY=
EMBEDDING_MODEL=voyage-3-large
RERANK_MODEL=rerank-2.5
VECTOR_SEARCH_CANDIDATE_K=50
VECTOR_SEARCH_MIN_SCORE=0.8
VECTOR_SEARCH_MAX_RESULTS=10

# Supabase (vector store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Observabilidade
SENTRY_DSN=

# WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Ingestão de sites
SPIDER_API_KEY=

# Voz: google (default, usa GOOGLE_APPLICATION_CREDENTIALS) | elevenlabs
TTS_PROVIDER=google
GCS_AUDIO_BUCKET=alert-calls-audios
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Banco do cliente (tool execute_sql). CSV de hosts permitidos; vazio = qualquer host público.
CUSTOMER_DATABASE_ALLOWED_HOSTS=
# Permite loopback/rede privada (só para desenvolvimento local)
CUSTOMER_DATABASE_ALLOW_INTERNAL_NETWORK=false
CUSTOMER_DATABASE_STATEMENT_TIMEOUT_MS=15000
CUSTOMER_DATABASE_CONNECTION_TIMEOUT_MS=5000
