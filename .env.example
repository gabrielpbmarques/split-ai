# Copie para .env e preencha. O schema em src/shared/config/env.ts é a fonte de verdade:
# variável inválida ou obrigatória ausente derruba o boot listando os problemas.

# Aplicação
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Banco de dados (obrigatória)
DATABASE_URL=postgres://user:password@localhost:5432/split_ai

# Autenticação (JWT_SECRET obrigatória)
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRATION_HOURS=24
BRAVOHUB_JWT_SECRET=
BRAVOHUB_ORG_ID=
BRAVOHUB_SCOPED_AGENTS=

# IA
ANTHROPIC_API_KEY=
AI_MODEL=
ORCHESTRATOR_MODEL=claude-sonnet-4-6
LANGCHAIN_PROJECT=

# Retrieval (Voyage + pgvector)
VOYAGEAI_API_KEY=
EMBEDDING_MODEL=voyage-3-large
RERANK_MODEL=rerank-2.5
VECTOR_SEARCH_CANDIDATE_K=50
VECTOR_SEARCH_MIN_SCORE=0.8
VECTOR_SEARCH_MAX_RESULTS=10

# Supabase (vector store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Observabilidade
SENTRY_DSN=

# E-mail
SENDGRID_API_KEY=
SENDGRID_EMAIL_DEFAULT_FROM=

# SMS / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Ingestão de sites
SPIDER_API_KEY=

# Pagamentos
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Voz (ElevenLabs, opcional; Google TTS usa GOOGLE_APPLICATION_CREDENTIALS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STT_MODEL_ID=scribe_v1
