{
  "name": "split-ai",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:maia": "TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register -r tsconfig-paths/register scripts/seed-maia.ts",
    "di:analyze": "bun run scripts/refactor-di/analyze.ts",
    "di:verify": "bun run scripts/refactor-di/verify.ts",
    "di:document": "bun run scripts/refactor-di/document.ts",
    "di:boot-check": "TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\",\"esModuleInterop\":true}' node -r ts-node/register -r tsconfig-paths/register scripts/refactor-di/boot-check.ts",
    "repair:thread": "TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register -r tsconfig-paths/register scripts/repair-thread-checkpoint.ts",
    "prepare": "husky install && chmod ug+x .husky/* && chmod ug+x .husky/_/*"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.58.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^11",
    "@fastify/multipart": "^8.3.1",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google-cloud/vision": "^4.3.3",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/classic": "^1.0.17",
    "@langchain/community": "^0.3.59",
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "0.3.12",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/devtools-integration": "^0.2.1",
    "@nestjs/platform-fastify": "^10.4.22",
    "@nestjs/swagger": "^7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^7.120.4",
    "@spider-cloud/spider-client": "^0.1.85",
    "@supabase/supabase-js": "^2.95.3",
    "@types/pg": "^8.16.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.2.24",
    "langsmith": "^0.4.12",
    "mammoth": "^1.12.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "mysql2": "^3.22.5",
    "nestjs-pino": "^4",
    "pg": "^8.18.0",
    "pino": "^9",
    "pino-http": "^10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^20.3.1",
    "supabase": "^1.226.4",
    "twilio": "^5.12.1",
    "typeorm": "^0.3.28",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bun": "latest",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.33",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-check-file": "^2.8.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "pino-pretty": "^13",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "<rootDir>/../test/setup-env.ts"
    ]
  }
}
